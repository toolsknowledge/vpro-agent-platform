
{
  "project": "VPRO Skills Agent Evaluation",
  "version": "1.0",
  "description": "Live evaluation scenarios for Tool Agent and MCP Agent",
  "test_cases": [
    {
      "id": "TOOL-001",
      "agent_type": "tool_agent",
      "category": "calculator",
